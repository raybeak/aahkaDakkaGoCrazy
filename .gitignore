# ==========================================
# Git Ignore Configuration
# Prevent sensitive keys, secrets, build artifacts,
# and dependency folders from being committed to Git.
# ==========================================

# 1. Environment & API Keys / Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.pub
*.crt
*.pfx
aahkadaakagocrazy.txt
secrets.json
config.local.json

# 2. Dependencies
node_modules/
/.pnp
.pnp.js

# 3. Build & Production Bundles
/dist
/build
/.next
/out
/coverage

# 4. Logs & Debug Info
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# 5. IDE & Editor Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.project
.settings/

# 6. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
